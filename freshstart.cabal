cabal-version: 3.0
name: freshstart
version: 0.1.0.0
build-type: Simple

executable freshstart
    main-is: Main.hs
    hs-source-dirs: app
    other-modules: FreshStart.Domain, FreshStart.MongoStore
    default-language: Haskell2010
    ghc-options: -Wall -threaded -rtsopts
    build-depends:
        base >=4.15 && <5,
        http-types >=0.12 && <0.13,
        lucid >=2.11 && <3,
        mongoDB ==2.7.1.4,
        network-uri >=2.6 && <3,
        scotty >=0.20 && <1,
        text >=1.2
